{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Practice analysis interpretation output",
  "description": "Model interpretation of program-produced aggregate facts. Evidence and statistics are resolved by the host through factIds; generationStatus belongs to the host envelope.",
  "$comment": "String length and list size limits are product contract defaults, not model provider limits.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "summary",
    "observations",
    "weaknesses",
    "strengths",
    "progress",
    "pendingReview",
    "suggestions",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2.0"
    },
    "status": {
      "$ref": "#/$defs/reportStatus"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "observations": {
      "$ref": "#/$defs/observationList"
    },
    "weaknesses": {
      "$ref": "#/$defs/observationList"
    },
    "strengths": {
      "$ref": "#/$defs/observationList"
    },
    "progress": {
      "$ref": "#/$defs/observationList"
    },
    "pendingReview": {
      "$ref": "#/$defs/observationList"
    },
    "suggestions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/suggestion"
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "maxLength": 250
      }
    }
  },
  "$defs": {
    "reportStatus": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "investment_only",
        "pending_review",
        "no_usable_data"
      ]
    },
    "factIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "References to input factId values, resolved and verified by the host."
    },
    "observationList": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "factIds"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "factIds": {
          "$ref": "#/$defs/factIds"
        }
      }
    },
    "suggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "action",
        "successCheck",
        "factIds"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "successCheck": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "factIds": {
          "$ref": "#/$defs/factIds"
        }
      }
    }
  }
}
