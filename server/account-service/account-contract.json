{
  "version": 2,
  "status": "implemented_real_loopback_http_verified_not_public_deployment_evidence",
  "listen": "127.0.0.1:8771",
  "publicPrefix": "/api/account",
  "transport": "trusted_https_via_existing_nginx",
  "identity": {
    "owner": "persistent_user_uuid_shared_by_all_authenticated_sessions",
    "registration": "username_and_password",
    "password": {
      "minCharacters": 15,
      "maxCharacters": 256,
      "maxUtf8Bytes": 1024,
      "algorithm": "scrypt",
      "N": 131072,
      "r": 8,
      "p": 1,
      "saltBytes": 16,
      "hashBytes": 32
    },
    "browser": {
      "cookie": "__Host-notelite-account",
      "httpOnly": true,
      "secure": true,
      "sameSite": "Strict",
      "path": "/",
      "days": 30,
      "csrfHeader": "X-NoteLite-CSRF",
      "requiresMatchingOriginForMutation": true
    },
    "native": {
      "authentication": "Bearer",
      "days": 90,
      "storage": "origin_scoped_platform_keychain"
    },
    "sessionStorage": "sha256_of_256_bit_random_tokens_only",
    "maxActiveSessions": 32,
    "consistencyHeader": "X-NoteLite-Expected-User",
    "mismatchedExpectedUser": 409,
    "fallbackWhenAccountCookieInvalid": false,
    "permanentDeletion": {
      "method": "DELETE",
      "path": "/account",
      "required": [
        "password",
        "confirmation"
      ],
      "confirmation": "DELETE_ACCOUNT",
      "requiresCurrentSessionAndPassword": true,
      "browserRequiresOriginAndCSRF": true,
      "allSessionsRemoved": true,
      "completedStatus": 200,
      "queuedCleanupStatus": 202,
      "responseFields": [
        "authenticated:false",
        "accountDeleted:true",
        "deletionRequested:true",
        "deleted:boolean",
        "status:completed|pending"
      ],
      "ownerDataRemoved": [
        "user",
        "sessions",
        "personal_scores",
        "score_request_ids",
        "history_snapshots",
        "analysis_versions",
        "model_requests_and_caches",
        "class_memberships",
        "own_homework_submissions",
        "own_uploaded_recordings",
        "owned_omr_inputs_results_musicxml_midi_and_revisions"
      ],
      "creatorClassDeletion": "closes_owned_courses_assignments_codes_and_shared_homework",
      "otherUserBoundary": "retains_previously_delivered_personal_score_copies_and_other_users_private_history",
      "unavailableCleanup": "durable_opaque_uuid_queue_retried_every_15_seconds_and_on_restart",
      "concurrency": "uncommitted_gateway_writer_fence_rolls_back_with_account_sql_failure; delayed_owner_writes_rejected; ongoing_omr_cancelled_before_removal"
    }
  },
  "officialSeed": {
    "id": "notelite-four-notes-v1",
    "revision": 1,
    "title": "NoteLite 四音练习",
    "license": "CC0-1.0",
    "notes": [
      60,
      62,
      64,
      65
    ],
    "meter": "4/4",
    "tempo": 80
  },
  "score": {
    "create": {
      "method": "POST",
      "path": "/scores",
      "fields": [
        "title",
        "musicxml",
        "requestId?"
      ],
      "alternateFields": [
        "title",
        "jobId",
        "scoreIndex",
        "revision",
        "requestId?"
      ],
      "idempotencyScope": "user_uuid_plus_request_uuid",
      "duplicate": 200,
      "first": 201,
      "changedRequestIdPayload": 409
    },
    "get": {
      "method": "GET",
      "path": "/scores/{uuid}",
      "fields": [
        "id",
        "title",
        "revision",
        "updatedAt",
        "etag",
        "omr?"
      ]
    },
    "xml": {
      "method": "GET",
      "path": "/scores/{uuid}/musicxml"
    },
    "update": {
      "method": "PUT",
      "path": "/scores/{uuid}",
      "fields": [
        "musicxml",
        "title?"
      ],
      "requiredHeader": "If-Match",
      "etagFormat": "\"{scoreUuid}:{revision}\"",
      "stale": 409,
      "missingEtag": 428
    },
    "ownerUnknownOrMismatch": 404,
    "maxXmlBytes": 10485760,
    "maxPersonalScores": 1000,
    "maxPersonalXmlBytes": 104857600
  },
  "history": {
    "append": {
      "method": "POST",
      "path": "/history",
      "required": [
        "eventId",
        "sourceKind",
        "scoreId",
        "mode",
        "durationSeconds",
        "startedAt",
        "endedAt"
      ],
      "optional": [
        "scoreRevision",
        "analysis"
      ],
      "sourceKind": [
        "official",
        "personal"
      ],
      "mode": [
        "free",
        "strict",
        "follow",
        "playback"
      ],
      "eventId": "uuid_unique_per_user",
      "duplicate": 200,
      "first": 201,
      "changedEventPayload": 409,
      "staleScoreRevision": 409
    },
    "list": {
      "method": "GET",
      "path": "/history",
      "query": [
        "limit?",
        "cursor?"
      ],
      "response": [
        "events",
        "nextCursor"
      ]
    },
    "snapshot": {
      "method": "GET",
      "path": "/history/{eventId}/musicxml",
      "ownership": "only_event_owner",
      "immutable": true,
      "etag": "snapshot_sha256"
    },
    "storedScore": [
      "exact_musicxml",
      "scoreRevision",
      "scoreSha256"
    ],
    "timingProvenance": "client_reported",
    "unknownAnalysis": {
      "status": "unanalysed",
      "source": "none",
      "errors": null,
      "verifiedByServer": false
    },
    "acceptedAnalysis": {
      "status": [
        "uncertain",
        "analysed"
      ],
      "source": "client-reported",
      "errorTypes": [
        "wrong",
        "missed",
        "extra",
        "rhythm",
        "uncertain"
      ],
      "optionalErrorFields": [
        "noteId",
        "measure",
        "expectedMidi",
        "playedMidi",
        "cents",
        "confidence"
      ],
      "verifiedByServer": false
    },
    "freeOrPlaybackCannotContainPitchAnalysis": true,
    "maxEvents": 20000,
    "maxSnapshotBytesPerUser": 104857600
  },
  "classroom": {
    "roles": [
      "teacher_from_creator",
      "student_from_code"
    ],
    "create": {
      "method": "POST",
      "path": "/courses",
      "fields": [
        "title"
      ],
      "maxTitleCharacters": 40
    },
    "shareScore": {
      "method": "POST",
      "path": "/courses/{uuid}/scores",
      "fields": [
        "sourceKind",
        "scoreId"
      ],
      "teacherOnly": true,
      "immutableSnapshot": true
    },
    "createCode": {
      "method": "POST",
      "path": "/courses/{uuid}/codes",
      "optional": [
        "ttlSeconds",
        "maxUses"
      ],
      "defaultTtlSeconds": 86400,
      "maximumTtlSeconds": 604800,
      "defaultMaxUses": 50,
      "maximumMaxUses": 500
    },
    "codeFormat": {
      "length": 6,
      "alphabet": "ABCDEFGHJKLMNPQRSTUVWXYZ23456789",
      "entropyBits": 30,
      "generation": "cryptographic_uniform_random",
      "storage": "sha256_only"
    },
    "preview": {
      "method": "POST",
      "path": "/course-codes/preview",
      "fields": [
        "code"
      ],
      "response": [
        "courseId",
        "title",
        "teacher",
        "expiresAt",
        "sharingScope"
      ]
    },
    "join": {
      "method": "POST",
      "path": "/course-codes/join",
      "fields": [
        "code"
      ],
      "idempotent": true,
      "role": "student"
    },
    "previewAndJoinCombinedLimit": {
      "perAccountPerMinute": 6,
      "perRealIpPerMinute": 20
    },
    "revokeCode": {
      "method": "DELETE",
      "path": "/courses/{uuid}/codes/{codeId}",
      "teacherOnly": true
    },
    "leave": {
      "method": "DELETE",
      "path": "/courses/{uuid}/membership",
      "retainsPreviouslySubmittedHomework": true
    },
    "roster": {
      "method": "GET",
      "path": "/courses/{uuid}/roster",
      "teacherOnly": true
    },
    "assignmentCreate": {
      "method": "POST",
      "path": "/courses/{uuid}/assignments",
      "required": [
        "title",
        "courseScoreId"
      ],
      "optional": [
        "dueAt",
        "requirements"
      ],
      "teacherOnly": true
    },
    "assignmentList": {
      "method": "GET",
      "path": "/courses/{uuid}/assignments"
    },
    "submission": {
      "method": "POST",
      "path": "/assignments/{uuid}/submissions",
      "required": [
        "eventId"
      ],
      "optional": [
        "uploadId",
        "analysis"
      ],
      "studentOnly": true,
      "requiresMatchingAssignedScore": true,
      "idempotency": "assignment_plus_user_plus_event"
    },
    "submissionList": {
      "method": "GET",
      "path": "/assignments/{uuid}/submissions",
      "teacher": "only_own_classroom_assignment",
      "student": "only_own_submissions"
    },
    "submissionRead": {
      "method": "GET",
      "path": "/submissions/{uuid}",
      "access": "submitting_student_or_that_classroom_teacher"
    },
    "submissionScore": {
      "method": "GET",
      "path": "/submissions/{uuid}/musicxml",
      "access": "submitting_student_or_that_classroom_teacher",
      "immutablePracticedSnapshot": true
    },
    "submissionAudio": {
      "method": "GET",
      "path": "/submissions/{uuid}/audio",
      "access": "submitting_student_or_that_classroom_teacher",
      "supportsSingleByteRange": true
    },
    "privateHistoryAutoShared": false,
    "unsubmittedRecordingsShared": false,
    "selfPromotionAllowed": false
  },
  "recording": {
    "create": {
      "method": "POST",
      "path": "/uploads",
      "required": [
        "assignmentId",
        "size",
        "mime",
        "sha256"
      ]
    },
    "status": {
      "method": "GET",
      "path": "/uploads/{uuid}"
    },
    "chunk": {
      "method": "PUT",
      "path": "/uploads/{uuid}",
      "contentType": "application/octet-stream",
      "requiredHeader": "Upload-Offset",
      "maxBytes": 8388608,
      "offsetConflict": 409
    },
    "complete": {
      "method": "POST",
      "path": "/uploads/{uuid}/complete",
      "checks": [
        "declared_size",
        "sha256",
        "container_magic",
        "wav_pcm_frames_if_wav"
      ]
    },
    "mimeTypes": [
      "audio/wav",
      "audio/mpeg",
      "audio/ogg",
      "audio/mp4"
    ],
    "defaultFileLimitBytes": 104857600,
    "defaultAccountLimitBytes": 1073741824,
    "defaultDiskReserveBytes": 268435456,
    "storage": "private_uuid_files_not_sqlite_blob",
    "unfinishedUploadDays": 7,
    "serverPitchAnalysis": false
  },
  "integration": {
    "resolve": {
      "method": "POST",
      "path": "/internal/account/resolve",
      "requiredHeader": "X-NoteLite-Internal-Key",
      "request": [
        "token",
        "kind"
      ],
      "response": [
        "owner",
        "sessionId",
        "kind",
        "csrfHash",
        "expiresAt"
      ],
      "publicNginxAccess": "deny_404"
    },
    "omrImportHook": "callback(user_uuid,job_uuid,score_index,requested_revision)->exact_musicxml_after_owner_and_revision_checks",
    "omrImportDefault": "fail_closed_503",
    "legacyClaim": {
      "method": "POST",
      "path": "/legacy/claim",
      "required": [
        "deviceToken",
        "deviceKind"
      ],
      "optional": [
        "deviceCSRF"
      ],
      "requires": "authenticated_account_plus_verified_legacy_device_and_browser_csrf_if_applicable",
      "default": "fail_closed_503",
      "callerOwnerFieldAccepted": false
    },
    "silentlyMigrateGuestDataOnLogin": false
  },
  "scope": {
    "newPublicEngineNames": {
      "recognition": "NoteLite",
      "listening": "NoteWise"
    },
    "listeningEngineConnected": false,
    "billingImplemented": false,
    "usernamePasswordRecoveryImplemented": false
  }
}
